@@ -0,0 +1,30 @@
+package com.moldyhub.fuku
+
+import java.util.concurrent.TimeUnit
+import kotlin.concurrent.thread
+
+/** Runs one-off commands as root through the device's `su`. */
+object RootShell {
+    data class Result(val exitCode: Int, val output: String)
+
+    /** Blocking. Call from a background thread. A root-grant prompt may take a while to answer. */
+    fun run(command: String, timeoutSeconds: Long = 30): Result {
+        return try {
+            val process = ProcessBuilder("su", "-c", command).redirectErrorStream(true).start()
+            var output = ""
+            val reader = thread(isDaemon = true) {
+                output = process.inputStream.bufferedReader().readText()
+            }
+            if (!process.waitFor(timeoutSeconds, TimeUnit.SECONDS)) {
+                process.destroy()
+                return Result(-1, "Timed out waiting for root.")
+            }
+            reader.join(1000)
+            Result(process.exitValue(), output.trim())
+        } catch (e: Exception) {
+            Result(-1, e.message ?: e.javaClass.simpleName)
+        }
+    }
+
+    fun isAvailable(): Boolean = run("id").output.contains("uid=0")
+}
diff --git a/app/src/main/java/com/moldyhub/fuku/WindowLauncher.kt b/app/src/main/java/com/moldyhub/fuku/WindowLauncher.kt
new file mode 100644
index 0000000..55ab610
--- /dev/null
+++ b/app/src/main/java/com/moldyhub/fuku/WindowLauncher.kt
@@ -0,0 +1,118 @@
+package com.moldyhub.fuku
+
+import android.app.ActivityOptions
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.graphics.Rect
+import android.graphics.drawable.Drawable
+import android.os.Build
+import android.provider.Settings
+import android.util.DisplayMetrics
+import android.view.WindowManager
+
+/** A clone that Fuku built and Android has installed as its own package. */
+data class InstalledClone(
+    val label: String,
+    val packageName: String,
+    val icon: Drawable
+)
+
+/**
+ * Opens installed clones in separate, resizable windows using Android's own windowing.
+ *
+ * Fuku does not host the clones; each one is a normal installed app. We only ask the system to
+ * start it with launch bounds. The system draws the title bar and the minimize/maximize/close
+ * buttons, and it only floats the window when freeform (desktop) windowing is available.
+ * Otherwise Android ignores the bounds and opens the clone full screen.
+ */
+object WindowLauncher {
+    // Matches the package names produced by CloneApkBuilder, e.g. com.roblox.client.fuku.c001
+    private val CLONE_PACKAGE = Regex("""\.fuku\.c\d{3}$""")
+
+    private const val WINDOW_STEP_DP = 40
+    private const val WINDOW_CASCADE_SLOTS = 6
+
+    @Suppress("DEPRECATION")
+    fun findClones(pm: PackageManager): List<InstalledClone> =
+        pm.getInstalledApplications(PackageManager.GET_META_DATA)
+            .asSequence()
+            .filter { CLONE_PACKAGE.containsMatchIn(it.packageName) }
+            .filter { pm.getLaunchIntentForPackage(it.packageName) != null }
+            .map { info ->
+                InstalledClone(
+                    label = pm.getApplicationLabel(info).toString(),
+                    packageName = info.packageName,
+                    icon = pm.getApplicationIcon(info)
+                )
+            }
+            .sortedBy { it.packageName }
+            .toList()
+
+    /**
+     * Starts [packageName] in a floating window. [slot] offsets the window so several windows
+     * opened together do not sit exactly on top of each other.
+     * Returns null on success, or a short error message.
+     */
+    fun launchInWindow(context: Context, packageName: String, slot: Int): String? {
+        val intent = context.packageManager.getLaunchIntentForPackage(packageName)
+            ?: return "$packageName has no launchable screen."
+        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        return try {
+            val options = ActivityOptions.makeBasic().setLaunchBounds(windowBounds(context, slot))
+            context.startActivity(intent, options.toBundle())
+            null
+        } catch (e: Exception) {
+            "Could not open $packageName: ${e.message ?: e.javaClass.simpleName}"
+        }
+    }
+
+    /** Opens every clone in its own cascaded window. Returns the first error, if any. */
+    fun launchAllInWindows(context: Context, clones: List<InstalledClone>): String? {
+        var firstError: String? = null
+        clones.forEachIndexed { index, clone ->
+            val error = launchInWindow(context, clone.packageName, index)
+            if (error != null && firstError == null) firstError = error
+        }
+        return firstError
+    }
+
+    /**
+     * Best-effort guess at whether this device will honour floating windows. Android does not
+     * offer a reliable public check, so this can be wrong in both directions; it is only used to
+     * show a hint, never to block launching.
+     */
+    fun freeformLikelySupported(context: Context): Boolean {
+        val pm = context.packageManager
+        if (pm.hasSystemFeature(PackageManager.FEATURE_FREEFORM_WINDOW_MANAGEMENT)) return true
+        if (pm.hasSystemFeature("android.hardware.type.pc")) return true
+        return runCatching {
+            Settings.Global.getInt(context.contentResolver, "enable_freeform_support", 0) != 0
+        }.getOrDefault(false)
+    }
+
+    internal fun displayBounds(context: Context): Rect {
+        val wm = context.getSystemService(Context.WINDOW_SERVICE) as WindowManager
+        return if (Build.VERSION.SDK_INT >= 30) {
+            wm.maximumWindowMetrics.bounds
+        } else {
+            val metrics = DisplayMetrics()
+            @Suppress("DEPRECATION")
+            wm.defaultDisplay.getRealMetrics(metrics)
+            Rect(0, 0, metrics.widthPixels, metrics.heightPixels)
+        }
+    }
+
+    /** A 16:9 landscape window, cascaded down and right by [slot], kept inside the display. */
+    internal fun windowBounds(context: Context, slot: Int): Rect {
+        val display = displayBounds(context)
+        val density = context.resources.displayMetrics.density
+        val width = (display.width() * if (display.width() >= display.height()) 0.5f else 0.9f).toInt()
+        val height = width * 9 / 16
+        val step = (WINDOW_STEP_DP * density).toInt()
+        val offset = step * (1 + slot.coerceAtLeast(0) % WINDOW_CASCADE_SLOTS)
+        val left = (display.left + offset).coerceAtMost(display.right - width).coerceAtLeast(display.left)
+        val top = (display.top + offset).coerceAtMost(display.bottom - height).coerceAtLeast(display.top)
+        return Rect(left, top, left + width, top + height)
+    }
+}
diff --git a/app/src/main/java/com/moldyhub/fuku/rootinput/InputServer.kt b/app/src/main/java/com/moldyhub/fuku/rootinput/InputServer.kt
new file mode 100644
index 0000000..75bf84f
--- /dev/null
+++ b/app/src/main/java/com/moldyhub/fuku/rootinput/InputServer.kt
@@ -0,0 +1,101 @@
+package com.moldyhub.fuku.rootinput
+
+import android.os.SystemClock
+import android.view.InputEvent
+import android.view.MotionEvent
+import java.io.BufferedReader
+import java.io.InputStreamReader
+import java.lang.reflect.Method
+
+/**
+ * Runs as root, outside the Fuku app process:
+ *
+ *   CLASSPATH=<Fuku base.apk> app_process /system/bin com.moldyhub.fuku.rootinput.InputServer
+ *
+ * It reads touch lines from stdin and injects them into the display they name. Only root (or the
+ * shell) may inject input into another app's display, which is why this is a separate process.
+ *
+ * Line format (space separated):
+ *   M <displayId> <action> <downTimeMs> <pointerCount> {<pointerId> <x> <y> <pressure>}...
+ *
+ * Keep this class and its main() when minifying (see proguard-rules.pro).
+ */
+object InputServer {
+    private const val SOURCE_TOUCHSCREEN = 0x1002 // InputDevice.SOURCE_TOUCHSCREEN
+    private const val INJECT_MODE_ASYNC = 0
+
+    @JvmStatic
+    fun main(args: Array<String>) {
+        val injector = Injector()
+        System.out.println("InputServer ready")
+        val reader = BufferedReader(InputStreamReader(System.`in`))
+        while (true) {
+            val line = reader.readLine() ?: break // stdin closed: the app is gone
+            try {
+                injector.handle(line)
+            } catch (t: Throwable) {
+                System.err.println("InputServer error: $t")
+            }
+        }
+    }
+
+    private class Injector {
+        private val manager: Any
+        private val inject: Method
+        private val setDisplayId: Method
+
+        init {
+            // Android 14+ moved the singleton to InputManagerGlobal.
+            val managerClass = try {
+                Class.forName("android.hardware.input.InputManagerGlobal")
+            } catch (e: ClassNotFoundException) {
+                Class.forName("android.hardware.input.InputManager")
+            }
+            manager = managerClass.getDeclaredMethod("getInstance").invoke(null)
+                ?: error("No InputManager instance")
+            inject = manager.javaClass.getMethod(
+                "injectInputEvent",
+                InputEvent::class.java,
+                Int::class.javaPrimitiveType
+            )
+            setDisplayId = InputEvent::class.java.getMethod(
+                "setDisplayId",
+                Int::class.javaPrimitiveType
+            )
+        }
+
+        fun handle(line: String) {
+            val parts = line.trim().split(' ')
+            if (parts.size < 5 || parts[0] != "M") return
+            val displayId = parts[1].toInt()
+            val action = parts[2].toInt()
+            val downTime = parts[3].toLong()
+            val count = parts[4].toInt()
+            if (count < 1 || parts.size < 5 + count * 4) return
+
+            val properties = Array(count) { MotionEvent.PointerProperties() }
+            val coords = Array(count) { MotionEvent.PointerCoords() }
+            for (i in 0 until count) {
+                val base = 5 + i * 4
+                properties[i].id = parts[base].toInt()
+                properties[i].toolType = MotionEvent.TOOL_TYPE_FINGER
+                coords[i].x = parts[base + 1].toFloat()
+                coords[i].y = parts[base + 2].toFloat()
+                coords[i].pressure = parts[base + 3].toFloat()
+                coords[i].size = 1f
+            }
+
+            val now = SystemClock.uptimeMillis()
+            val event = MotionEvent.obtain(
+                minOf(downTime, now), now, action, count, properties, coords,
+                0, 0, 1f, 1f, 0, 0, SOURCE_TOUCHSCREEN, 0
+            )
+            try {
+                setDisplayId.invoke(event, displayId)
+                inject.invoke(manager, event, INJECT_MODE_ASYNC)
+            } finally {
+                event.recycle()
+            }
+        }
+    }
+}
