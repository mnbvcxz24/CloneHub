+    /**
+     * Clones built with the clone runtime hide the game's own launcher behind an injected setup
+     * screen (RuntimeEntryActivity), so the normal launch intent would show that screen inside
+     * the window instead of the game. Start the game's real launcher directly; fall back to the
+     * normal launch intent for clones built without the runtime.
+     */
+    private fun launchIntentFor(pkg: String): Intent? {
+        val original = try {
+            context.packageManager.getApplicationInfo(pkg, PackageManager.GET_META_DATA)
+                .metaData?.getString(META_ORIGINAL_LAUNCHER)?.takeIf { it.isNotBlank() }
+        } catch (_: PackageManager.NameNotFoundException) {
+            null
+        }
+        if (original != null) {
+            return Intent(Intent.ACTION_MAIN)
+                .addCategory(Intent.CATEGORY_LAUNCHER)
+                .setComponent(ComponentName(pkg, original))
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        }
+        return context.packageManager.getLaunchIntentForPackage(pkg)
+    }
